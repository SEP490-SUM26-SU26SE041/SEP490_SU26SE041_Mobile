## NAVIGATION (GoRouter)

```dart
// lib/core/router/app_router.dart
import 'package:go_router/go_router.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
// Import all screens here
import '../../features/auth/presentation/login_screen.dart';
import '../../features/dashboard/presentation/dashboard_screen.dart';
import '../../features/experiments/presentation/experiment_list_screen.dart';
import '../../features/experiments/presentation/experiment_detail_screen.dart';
import '../../features/nursery_batches/presentation/batch_list_screen.dart';
import '../../features/nursery_batches/presentation/batch_detail_screen.dart';
import '../../features/farm_map/presentation/farm_map_screen.dart';
import '../../features/care_schedules/presentation/schedule_list_screen.dart';
import '../../shared/widgets/main_shell.dart'; // Assuming MainShell is a shared widget for bottom nav

final routerProvider = Provider<GoRouter>((ref) {
  final authState = ref.watch(authStateProvider);

  return GoRouter(
    initialLocation: '/dashboard',
    redirect: (context, state) {
      final isLoggedIn = authState.isAuthenticated;
      final isLoginRoute = state.matchedLocation == '/login';

      if (!isLoggedIn && !isLoginRoute) return '/login';
      if (isLoggedIn && isLoginRoute) return '/dashboard';
      return null;
    },
    routes: [
      GoRoute(path: '/login', builder: (_, __) => const LoginScreen()),
      // Add Forgot Password route
      GoRoute(path: '/forgot-password', builder: (_, __) => const ForgotPasswordScreen()), // Assuming ForgotPasswordScreen exists
      ShellRoute(
        builder: (context, state, child) => MainShell(child: child),
        routes: [
          GoRoute(
            path: '/dashboard',
            builder: (_, __) => const DashboardScreen(),
          ),
          GoRoute(
            path: '/experiments',
            builder: (_, __) => const ExperimentListScreen(),
            routes: [
              GoRoute(
                path: ':id',
                builder: (_, state) => ExperimentDetailScreen(
                  id: state.pathParameters['id']!,
                ),
              ),
              GoRoute(path: 'create', builder: (_, __) => const CreateExperimentScreen()), // Assuming CreateExperimentScreen exists
              GoRoute(path: ':id/observations', builder: (_, state) => ObservationLogScreen(experimentId: state.pathParameters['id']!)), // Assuming ObservationLogScreen exists
            ],
          ),
          GoRoute(
            path: '/batches',
            builder: (_, __) => const BatchListScreen(),
            routes: [
              GoRoute(
                path: ':id',
                builder: (_, state) => BatchDetailScreen(
                  id: state.pathParameters['id']!,
                ),
              ),
              GoRoute(path: 'create', builder: (_, __) => const CreateBatchScreen()), // Assuming CreateBatchScreen exists
            ],
          ),
          GoRoute(
            path: '/farm',
            builder: (_, __) => const FarmMapScreen(),
            routes: [
              GoRoute(path: 'zones/:id', builder: (_, state) => ZoneDetailScreen(zoneId: state.pathParameters['id']!)), // Assuming ZoneDetailScreen exists
              GoRoute(path: 'zones/:zoneId/beds/:bedId', builder: (_, state) => BedDetailScreen(zoneId: state.pathParameters['zoneId']!, bedId: state.pathParameters['bedId']!)), // Assuming BedDetailScreen exists
            ],
          ),
          GoRoute(
            path: '/schedules',
            builder: (_, __) => const ScheduleListScreen(),
            routes: [
              GoRoute(path: ':id', builder: (_, state) => ScheduleDetailScreen(id: state.pathParameters['id']!)), // Assuming ScheduleDetailScreen exists
              GoRoute(path: 'create', builder: (_, __) => const CreateScheduleScreen()), // Assuming CreateScheduleScreen exists
            ],
          ),
          // Admin routes
          GoRoute(path: '/admin/users', builder: (_, __) => const UserManagementScreen()), // Assuming UserManagementScreen exists
          GoRoute(path: '/admin/config', builder: (_, __) => const SystemConfigScreen()), // Assuming SystemConfigScreen exists
          GoRoute(path: '/admin/kpis', builder: (_, __) => const KPIConfigScreen()), // Assuming KPIConfigScreen exists
          GoRoute(path: '/sensors/:id', builder: (_, state) => SensorDetailScreen(id: state.pathParameters['id']!)), // Assuming SensorDetailScreen exists
        ],
      ),
    ],
  );
});
