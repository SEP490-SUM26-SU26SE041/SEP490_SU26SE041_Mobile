# SNMS Testing Protocol

## Test Categories

### 1. Widget Tests (UI)

Mỗi widget mới PHẢI có widget test. Place test trong `test/features/[feature_name]/widgets/`.

**Test structure:**
```dart
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

void main() {
  group('[WidgetName]', () {
    group('rendering', () {
      testWidgets('renders correctly with required data', (tester) async {
        await tester.pumpWidget(
          ProviderScope(
            child: MaterialApp(
              theme: AppTheme.light,
              home: Scaffold(body: SNMSCard(child: Text('data'))),
            ),
          ),
        );
        expect(find.text('data'), findsOneWidget);
      });
    });

    group('states', () {
      testWidgets('shows loading shimmer', (tester) async {
        // ...
      });

      testWidgets('shows error with retry', (tester) async {
        // ...
      });

      testWidgets('shows empty state message', (tester) async {
        // ...
      });
    });

    group('interactions', () {
      testWidgets('triggers onTap callback', (tester) async {
        bool tapped = false;
        await tester.pumpWidget(
          ProviderScope(
            child: MaterialApp(
              home: Scaffold(
                body: SNMSCard(
                  onTap: () => tapped = true,
                  child: Text('tap me'),
                ),
              ),
            ),
          ),
        );
        await tester.tap(find.text('tap me'));
        expect(tapped, isTrue);
      });
    });

    group('theming', () {
      testWidgets('renders correctly in dark mode', (tester) async {
        await tester.pumpWidget(
          ProviderScope(
            child: MaterialApp(
              theme: AppTheme.dark,
              home: Scaffold(body: SNMSCard(child: Text('dark'))),
            ),
          ),
        );
        expect(find.text('dark'), findsOneWidget);
      });
    });
  });
}
```

### 2. Provider Tests (Logic)

Test Riverpod providers với mock repository. Place trong `test/features/[feature_name]/providers/`.

```dart
void main() {
  group('ExperimentsNotifier', () {
    late ProviderContainer container;

    setUp(() {
      container = ProviderContainer(
        overrides: [
          experimentRepositoryProvider.overrideWithValue(MockExperimentRepo()),
        ],
      );
    });

    tearDown(() => container.dispose());

    test('loadExperiments returns list on success', () async {
      final result = await container.read(experimentsProvider.future);
      expect(result, isNotEmpty);
    });

    test('createExperiment updates list after creation', () async {
      container.read(experimentActionsProvider.notifier).createExperiment(dto);
      container.read(experimentsProvider.invalidate);
      final result = await container.read(experimentsProvider.future);
      expect(result.length, 2);
    });
  });
}
```

### 3. Model Tests

Test Freezed models serialization. Place trong `test/models/`.

```dart
void main() {
  group('ExperimentModel', () {
    test('fromJson creates correct model', () {
      final json = {...};
      final model = ExperimentModel.fromJson(json);
      expect(model.id, equals('exp-001'));
    });

    test('toJson produces valid JSON', () {
      final model = ExperimentModel(...);
      final json = model.toJson();
      expect(json['id'], isNotNull);
    });

    test('copyWith creates modified copy', () {
      final original = ExperimentModel(...);
      final modified = original.copyWith(status: ExperimentStatus.completed);
      expect(modified.status, ExperimentStatus.completed);
      expect(original.status, ExperimentStatus.active);
    });
  });
}
```

### 4. Integration Tests

Test navigation flows và end-to-end user journeys. Place trong `test/integration/`.

**Test login → dashboard flow:**
```dart
void main() {
  integrationTest('researcher login and view dashboard', (tester) async {
    await tester.app.start();
    await tester.enterText(find.byKey(loginEmailKey), 'khoa.researcher@snms.vn');
    await tester.enterText(find.byKey(loginPasswordKey), 'password');
    await tester.tap(find.byKey(loginButtonKey));
    await tester.pumpAndSettle();
    expect(find.byType(DashboardScreen), findsOneWidget);
    expect(find.text('TS. Nguyễn Minh Khoa'), findsOneWidget);
  });
}
```

